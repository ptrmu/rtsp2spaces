#!/usr/bin/env python3
"""Live acceptance for native UID, LAN snapshots, task isolation and temperature."""
import argparse
import copy
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import tomllib
from urllib.parse import quote, quote_plus

ROOT = Path(__file__).resolve().parent.parent
CAMERAS = ('MazamaStakeCan', 'MazamaRanchCam')


def write_config(path, config, output):
    lines = [f'data_dir = {json.dumps(str(output))}',
             'tasks = ["MazamaStakeCan", "MazamaRanchCam", "ChechaquoTemp"]']
    for name, camera in config['cameras'].items():
        lines.append(f'[cameras.{name}]')
        for key in ('source', 'host', 'channel', 'crop', 'timeout_seconds', 'accept_invalid_certs'):
            if key in camera:
                lines.append(f'{key} = {json.dumps(camera[key])}')
    if 'temperature' in config:
        lines.append('[temperature]')
        for key, value in config['temperature'].items():
            lines.append(f'{key} = {json.dumps(value)}')
    path.write_text('\n'.join(lines) + '\n')


def credential_values(value):
    if isinstance(value, dict):
        for child in value.values():
            yield from credential_values(child)
    elif isinstance(value, str) and value:
        yield value


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--config', type=Path, default=ROOT / 'config.toml')
    parser.add_argument('--secrets-file', type=Path, default=ROOT / 'stake_cam_secrets.json')
    parser.add_argument('--only', help='Run checks whose label contains this text')
    args = parser.parse_args()
    config_path = args.config.resolve()
    credentials = args.secrets_file.resolve()
    config = tomllib.loads(config_path.read_text())
    secrets = json.loads(credentials.read_text())
    tokens = list(credential_values(secrets))
    tokens += [quote(v, safe='') for v in tokens] + [quote_plus(v) for v in tokens]
    print('Building stakecam...', flush=True)
    build = subprocess.run(['cargo', 'build', '--locked', '--bin', 'stakecam', '--message-format=json'], cwd=ROOT, capture_output=True, text=True)
    if build.returncode:
        raise RuntimeError('Cargo build failed')
    binary = next(json.loads(line)['executable'] for line in build.stdout.splitlines()
                  if json.loads(line).get('reason') == 'compiler-artifact'
                  and json.loads(line).get('executable')
                  and json.loads(line)['target']['name'] == 'stakecam')
    output = Path(config['data_dir'])
    if not output.is_absolute():
        output = config_path.parent / output
    output = output / 'live-tests'
    output.mkdir(parents=True, exist_ok=True)
    images = Path(tempfile.mkdtemp(prefix='run-', dir=output))
    failures = []

    def run(label, cfg, command=(), secret_path=credentials, expected=0, stems=(), diagnostic=None):
        if args.only and args.only not in label:
            return
        try:
            result = subprocess.run([binary, '--config', str(cfg), '--secrets-file', str(secret_path), '--verbose', *command],
                                    capture_output=True, text=True, timeout=80)
            if any(token in result.stdout + result.stderr for token in tokens):
                raise RuntimeError('credential appeared in output; output suppressed')
            if result.returncode != expected:
                markers = [marker for marker in (
                    'UID connection timed out', 'UID connection failed', 'UID login timed out',
                    'UID login failed', 'UID snapshot timed out', 'UID snapshot failed',
                    'Ambient request failed', 'Ambient API returned HTTP', 'camera request failed',
                    'camera response is not a JPEG', 'cannot decode camera JPEG',
                ) if marker in result.stderr]
                raise RuntimeError('unexpected exit status: ' + str(result.returncode) + '; ' + ', '.join(markers))
            for stem in stems:
                paths = [Path(line) for line in result.stdout.splitlines() if Path(line).name.startswith(stem)]
                if len(paths) != 1 or not paths[0].is_file() or paths[0].read_bytes()[:3] != b'\xff\xd8\xff':
                    raise RuntimeError('expected JPEG missing')
            if diagnostic and diagnostic not in result.stderr:
                raise RuntimeError('expected diagnostic missing; output suppressed')
            print(f'PASS: {label}', flush=True)
        except (RuntimeError, subprocess.TimeoutExpired) as error:
            failures.append(label)
            reason = str(error) if isinstance(error, RuntimeError) else 'process timed out'
            print(f'FAIL: {label}: {reason}', flush=True)

    with tempfile.TemporaryDirectory(prefix='stakecam-live-') as temporary:
        private = Path(temporary)
        normal = private / 'capture.toml'
        write_config(normal, config, images)
        for camera, stem in zip(CAMERAS, ('mazama_stake_can_', 'mazama_ranch_cam_')):
            run(f'{camera} focused capture', normal, ('capture', '--camera', camera), stems=(stem,))
        run('configured cameras and ChechaquoTemp', normal, stems=('mazama_stake_can_', 'mazama_ranch_cam_'))
        for failed, successful, stem in ((CAMERAS[0], CAMERAS[1], 'mazama_ranch_cam_'), (CAMERAS[1], CAMERAS[0], 'mazama_stake_can_')):
            partial = copy.deepcopy(secrets)
            del partial['cameras'][failed]
            secret_path = private / f'{failed}.json'
            with open(secret_path, 'w', opener=lambda path, flags: os.open(path, flags, 0o600)) as stream:
                json.dump(partial, stream)
            run(f'{failed} unavailable; {successful} succeeds', normal,
                ('capture', '--camera', failed, '--camera', successful), secret_path, 1, (stem,))
        bad = copy.deepcopy(secrets)
        bad_password = 'deliberately-invalid-live-test-password'
        tokens.append(bad_password)
        bad['cameras'][CAMERAS[0]]['password'] = bad_password
        wrong = private / 'wrong.json'
        with open(wrong, 'w', opener=lambda path, flags: os.open(path, flags, 0o600)) as stream:
            json.dump(bad, stream)
        run('wrong Stake password (one attempt)', normal, ('capture', '--camera', CAMERAS[0]), wrong, 1, diagnostic='camera API error')
        unreachable_config = copy.deepcopy(config)
        unreachable_config['cameras'][CAMERAS[0]].update(host='192.0.2.1', timeout_seconds=2)
        unreachable = private / 'unreachable.toml'
        write_config(unreachable, unreachable_config, images)
        run('unreachable LAN camera; Ranch succeeds', unreachable,
            ('capture', '--camera', CAMERAS[0], '--camera', CAMERAS[1]), expected=1, stems=('mazama_ranch_cam_',))
        blocked = private / 'blocked'
        blocked.write_text('regular file prevents directory creation')
        invalid = private / 'invalid-output.toml'
        write_config(invalid, config, blocked)
        run('output directory failure', invalid, ('capture', '--camera', CAMERAS[0]), expected=1, diagnostic='cannot create capture directory')
    print(f'Images retained for inspection: {images}')
    return int(bool(failures))


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, RuntimeError, StopIteration):
        print('Live test setup failed; details suppressed to protect credentials.', file=sys.stderr)
        sys.exit(1)
